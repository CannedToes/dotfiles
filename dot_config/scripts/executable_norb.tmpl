{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

flake="${NIXOS_CONFIG_DIR:-$HOME/.config/nixos}"

usage() {
  cat <<EOF
usage:
  norb <action> [host]

actions:
  s, switch   nixos-rebuild switch
  b, boot     nixos-rebuild boot
  t, test     nixos-rebuild test
  dry         nixos-rebuild dry-build
  build       nixos-rebuild build

environment:
  NIXOS_CONFIG_DIR   path to flake directory
                     default: ~/.config/nixos

examples:
  norb s laptop
  norb b server
  norb test laptop
  norb s
  NIXOS_CONFIG_DIR=~/dotfiles norb s laptop
EOF
}

action="${1:-}"
host="${2:-$(hostname -s)}"

case "$action" in
  s|switch)
    action="switch"
    ;;
  b|boot)
    action="boot"
    ;;
  t|test)
    action="test"
    ;;
  dry|dry-build)
    action="dry-build"
    ;;
  build)
    action="build"
    ;;
  h|help|-h|--help|"")
    usage
    exit 0
    ;;
  *)
    echo "norb: unknown action: $action" >&2
    usage >&2
    exit 1
    ;;
esac

sudo nixos-rebuild "$action" --flake "$flake#$host"
{{ end -}}
