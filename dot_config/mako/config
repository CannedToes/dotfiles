font=monospace 10
width=400
height=120

outer-margin=0,5,5,0
margin=0
padding=10

border-size=1
border-radius=0

icons=1
max-icon-size=40
markup=1
actions=1

default-timeout=5000
ignore-timeout=0
layer=overlay
anchor=bottom-right
sort=-time

background-color=#1c1c24ff
text-color=#cdcdcdff
border-color=#606079ff
progress-color=over #252530ff

format=<b>%s</b>\n<span foreground="#878787">%a</span>\n%b

[urgency=low]
background-color=#141415ff
border-color=#252530ff
text-color=#878787ff
default-timeout=3000

[urgency=normal]
background-color=#1c1c24ff
border-color=#606079ff
text-color=#cdcdcdff
default-timeout=4500

[urgency=high]
background-color=#252530ff
border-color=#d8647eff
text-color=#ffffffff
default-timeout=0

[mode=do-not-disturb]
invisible=1
