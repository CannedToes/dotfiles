{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 0,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": [],
  "modules-right": ["tray", "wireplumber", "network", "battery", "clock"],
  "sway/workspaces": {
    "disable-scroll": true,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "{}"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "wireplumber": {
    "format": "vol {volume}%",
    "format-muted": "muted"
  },
  "network": {
    "format-wifi": "net {essid}",
    "format-ethernet": "net wired",
    "format-disconnected": "net down",
    "tooltip": false
  },
  "battery": {
    "format": "bat {capacity}%",
    "format-charging": "bat {capacity}%+",
    "format-full": "bat full",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "tooltip": false
  }
}
