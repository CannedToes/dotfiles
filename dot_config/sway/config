set $mod Mod4
set $term foot
set $menu fuzzel
set $wallpaper /home/myles/Pictures/wallpapers/night.jpg

# -- vague palette --
set $bg      #141415
set $bg2     #1c1c24
set $bg3     #252530
set $blue    #7e98e8
set $blue2   #6e94b2
set $cyan    #8ba9a3
set $dim     #606079
set $fg      #cdcdcd
set $green   #7fa563
set $mauve   #bb9dbd
set $muted   #878787
set $red     #d8647e
set $yellow  #f3be7c

# -- basics --
font pango:Monaspace Krypton 10

floating_modifier $mod normal
focus_follows_mouse yes
mouse_warping none

default_border pixel 1
default_floating_border pixel 1
hide_edge_borders none
smart_borders off

# class                 border  backgr. text  indicator child_border
client.focused          $mauve  $bg2   $fg    $mauve    $mauve
client.focused_inactive $bg3    $bg    $muted $bg3      $bg3
client.unfocused        $bg3    $bg    $dim   $bg3      $bg3
client.urgent           $red    $bg    $fg    $red      $red
client.placeholder      $bg3    $bg    $dim   $bg3      $bg3
client.background       $bg

# -- input --
input type:keyboard {
    repeat_delay 220
    repeat_rate 45
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
}

seat * xcursor_theme Vanilla-DMZ 24

# -- background --
output * bg $wallpaper fill

# -- startup --
exec mako
exec waybar
exec nm-applet --indicator
exec blueman-applet
exec /run/current-system/sw/libexec/polkit-gnome-authentication-agent-1

exec swayidle -w \
    timeout 600 'swaylock -f -c 141415' \
    timeout 900 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 141415'

# -- launchers / session --
bindsym $mod+Return exec $term
bindsym $mod+Space exec $menu
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'exit sway?' -B 'yes' 'swaymsg exit'
bindsym $mod+Escape exec swaylock -f -c 141415

# Optional convenience launchers
bindsym $mod+b exec xdg-open about:blank
bindsym $mod+n exec foot nvim
bindsym $mod+e exec thunar
# bindsym $mod+Shift+e exec foot yazi
bindsym $mod+c exec speedcrunch

# -- focus --
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+a focus parent
bindsym $mod+Shift+a focus child

bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

# -- move windows --
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# -- outputs / monitors --
bindsym $mod+Alt+h focus output left
bindsym $mod+Alt+l focus output right
bindsym $mod+Alt+j focus output up
bindsym $mod+Alt+k focus output down

# bindsym $mod+Ctrl+h move workspace to output left
# bindsym $mod+Ctrl+l move workspace to output right
# bindsym $mod+Ctrl+j move workspace to output up
# bindsym $mod+Ctrl+k move workspace to output down

# -- layouts --
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle

bindsym $mod+v split vertical
bindsym $mod+g split horizontal

bindsym $mod+t split toggle

# -- scratchpad --
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# -- workspaces --
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Move container to workspace and follow it
bindsym $mod+Ctrl+Shift+1 move container to workspace number $ws1; workspace number $ws1
bindsym $mod+Ctrl+Shift+2 move container to workspace number $ws2; workspace number $ws2
bindsym $mod+Ctrl+Shift+3 move container to workspace number $ws3; workspace number $ws3
bindsym $mod+Ctrl+Shift+4 move container to workspace number $ws4; workspace number $ws4
bindsym $mod+Ctrl+Shift+5 move container to workspace number $ws5; workspace number $ws5
bindsym $mod+Ctrl+Shift+6 move container to workspace number $ws6; workspace number $ws6
bindsym $mod+Ctrl+Shift+7 move container to workspace number $ws7; workspace number $ws7
bindsym $mod+Ctrl+Shift+8 move container to workspace number $ws8; workspace number $ws8
bindsym $mod+Ctrl+Shift+9 move container to workspace number $ws9; workspace number $ws9
bindsym $mod+Ctrl+Shift+0 move container to workspace number $ws10; workspace number $ws10

# -- resize --
bindsym $mod+Ctrl+h resize grow width 10 px
bindsym $mod+Ctrl+j resize grow height 10 px
bindsym $mod+Ctrl+k resize shrink height 10 px
bindsym $mod+Ctrl+l resize shrink width 10 px

mode "resize" {
    bindsym h resize grow width 10 px
    bindsym j resize grow height 10 px
    bindsym k resize shrink height 10 px
    bindsym l resize shrink width 10 px

    bindsym Shift+h resize shrink width 30 px
    bindsym Shift+j resize grow height 30 px
    bindsym Shift+k resize shrink height 30 px
    bindsym Shift+l resize grow width 30 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# -- media / hardware --
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# -- screenshots --
# Area screenshot to clipboard
bindsym $mod+Shift+s exec sh -c 'grim -g "$(slurp)" - | wl-copy'

# Fullscreen screenshot to clipboard
bindsym $mod+Shift+f exec sh -c 'grim - | wl-copy'

# Area screenshot to file
bindsym Shift+Print exec sh -c 'mkdir -p "$HOME/Pictures/Screenshots"; grim -g "$(slurp)" "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"'

# Fullscreen screenshot to file
bindsym $mod+Shift+Print exec sh -c 'mkdir -p "$HOME/Pictures/Screenshots"; grim "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"'
