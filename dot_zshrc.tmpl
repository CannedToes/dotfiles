export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME=""

plugins=(git zsh-autosuggestions zsh-syntax-highlighting sudo copyfile copybuffer dirhistory history)

source $ZSH/oh-my-zsh.sh
eval "$(starship init zsh)"

alias alefmt="fd -t f -e nix -x alejandra -q"
alias ncg="sudo nix-collect-garbage --delete-older-than 3d"
alias neofetch="fastfetch"
alias ohmyzsh="nvim ~/.oh-my-zsh"
alias rbld="sudo nixos-rebuild switch --flake ~/.config/nixos#{{- .chezmoi.hostname -}}"
alias rbldlaptop="nixos-rebuild switch --flake ~/.config/nixos#laptop --target-host root@192.168.1.57"
alias rbldserver="nixos-rebuild switch --flake ~/.config/nixos#server --target-host root@192.168.1.158"
alias rbldwsl="nixos-rebuild switch --flake ~/.config/nixos#wsl --target-host root@192.168.1.152"
alias server="ssh root@192.168.1.158"
alias so="source ~/.zshrc"

export SSH_AUTH_SOCK="/run/user/$(id -u)/ssh-agent"
export MANPAGER="less -N --use-color -Dd+y -Du+208 -DN+r"
export DISABLE_AUTO_UPDATE="true"

