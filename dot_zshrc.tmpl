# -- aliases --
alias l="ls -lah"
alias la="ls -A"
alias ll="ls -lh"
alias lt="ls -lah --sort=time"
alias md="mkdir -p"
alias neofetch="fastfetch"
alias so="source ~/.zshrc"
{{ if eq .chezmoi.os "linux" -}}
alias ncg="sudo nix-collect-garbage --delete-older-than 3d"
alias rbld="sudo nixos-rebuild switch --flake"
{{ end -}}

# -- history --
HISTFILE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/history"
HISTSIZE=10000
SAVEHIST=10000

mkdir -p "${HISTFILE:h}"

setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY

# -- completions --
autoload -Uz compinit
zmodload zsh/complist
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}-- no matches --%f'
zstyle ':completion:*' group-name ''

# -- prompt --
setopt PROMPT_SUBST

# Vague-ish colors
PROMPT_USER="%F{#bb9dbd}"   # muted mauve
PROMPT_HOST="%F{#7e98e8}"   # soft blue
PROMPT_PATH="%F{#cdcdcd}"   # foreground
PROMPT_GIT="%F{#7fa563}"    # muted green
PROMPT_BAD="%F{#d8647e}"    # soft red
PROMPT_OK="%F{#7fa563}"     # muted green
PROMPT_DIM="%F{#606079}"    # comment gray
PROMPT_WARN="%F{#f3be7c}"   # muted yellow
PROMPT_RESET="%f"

GIT_PROMPT=""

prompt_git_status() {
  GIT_PROMPT=""

  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

  local branch staged unstaged untracked ahead behind upstream
  branch="$(git branch --show-current 2>/dev/null)"
  [[ -z "$branch" ]] && branch="$(git rev-parse --short HEAD 2>/dev/null)"

  staged="$(git diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ')"
  unstaged="$(git diff --name-only 2>/dev/null | wc -l | tr -d ' ')"
  untracked="$(git ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')"

  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"
  if [[ -n "$upstream" ]]; then
    ahead="$(git rev-list --count "${upstream}..HEAD" 2>/dev/null)"
    behind="$(git rev-list --count "HEAD..${upstream}" 2>/dev/null)"
  else
    ahead=0
    behind=0
  fi

  GIT_PROMPT=" ${PROMPT_DIM}on${PROMPT_RESET} ${PROMPT_GIT}git:${branch}${PROMPT_RESET}"

  (( staged > 0 )) && GIT_PROMPT+=" ${PROMPT_OK}+${staged}${PROMPT_RESET}"
  (( unstaged > 0 )) && GIT_PROMPT+=" ${PROMPT_WARN}!${unstaged}${PROMPT_RESET}"
  (( untracked > 0 )) && GIT_PROMPT+=" ${PROMPT_BAD}?${untracked}${PROMPT_RESET}"
  (( ahead > 0 )) && GIT_PROMPT+=" ${PROMPT_GIT}^${ahead}${PROMPT_RESET}"
  (( behind > 0 )) && GIT_PROMPT+=" ${PROMPT_BAD}v${behind}${PROMPT_RESET}"
}

precmd() {
  prompt_git_status
}

PROMPT='${PROMPT_USER}%n${PROMPT_RESET}${PROMPT_DIM}@${PROMPT_RESET}${PROMPT_HOST}%m${PROMPT_RESET} ${PROMPT_PATH}%~${PROMPT_RESET}${GIT_PROMPT} %(?.${PROMPT_OK}.${PROMPT_BAD})λ${PROMPT_RESET} '

# -- shell behaviour --
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt INTERACTIVE_COMMENTS

bindkey -e
